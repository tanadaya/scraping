# Movement / AIS Positions notebook 1
SEASEARCHER_LOGIN_USER_1=notebook-1-user@example.com
SEASEARCHER_LOGIN_PASSWORD_1=notebook-1-password

# Movement / AIS Positions notebook 2
SEASEARCHER_LOGIN_USER_2=notebook-2-user@example.com
SEASEARCHER_LOGIN_PASSWORD_2=notebook-2-password

# Vessels notebook or direct utility use (optional)
SEASEARCHER_LOGIN_USER=shared-user@example.com
SEASEARCHER_LOGIN_PASSWORD=shared-password
# Set this when the generic login user cannot be matched to account_1/account_2.
SEASEARCHER_ACCOUNT_ID=account_1

# Shared Google Sheets + Apps Script coordinator
# Required for normal scraping runs. The scraper fails closed if these are missing.
SCRAPE_COORDINATOR_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec
SCRAPE_COORDINATOR_TOKEN=replace-with-a-long-random-token
SCRAPE_OPERATOR=your-name

# Optional coordinator tuning (seconds)
SCRAPE_COORDINATOR_POLL_SECONDS=20
SCRAPE_COORDINATOR_HEARTBEAT_SECONDS=60
SCRAPE_COORDINATOR_PROGRESS_PUSH_SECONDS=15

# Emergency only: set to 1 to run without the shared lock.
# SCRAPE_COORDINATOR_BYPASS=1
